#!/bin/sh
# Refuse a push that changes .claude-plugin/plugin.json's version without a
# matching v<version> tag. Fires ONLY on a version change -- ordinary commits
# push untouched, so the check stays worth listening to.
#
# Test:  sh .githooks/pre-push </dev/null            -> exits 0 (nothing to check)
# Wire:  git config core.hooksPath .githooks

MANIFEST=.claude-plugin/plugin.json
ZERO=0000000000000000000000000000000000000000

version_at() {
  git show "$1:$MANIFEST" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])' 2>/dev/null
}

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  [ "$remote_sha" = "$ZERO" ] && continue         # brand-new branch, nothing to diff

  old=$(version_at "$remote_sha")
  new=$(version_at "$local_sha")
  [ -z "$new" ] && continue                       # no manifest on this ref
  [ "$old" = "$new" ] && continue                 # version untouched -- the common case

  if git tag --list "v$new" | grep -q .; then
    # tag exists: it must be reachable from what we are pushing
    if git merge-base --is-ancestor "v$new^{commit}" "$local_sha" 2>/dev/null; then
      continue
    fi
    echo "pre-push: plugin.json is $new but tag v$new does not point into this push." >&2
    echo "          Move it:  git tag -f -a v$new -m 'brand-studio v$new'" >&2
  else
    echo "pre-push: plugin.json went $old -> $new but tag v$new does not exist." >&2
    echo "          Create it:  git tag -a v$new -m 'brand-studio v$new'" >&2
    echo "          Then push:  git push origin v$new" >&2
  fi
  status=1
done

exit $status
